' =====================================================================
' DOMINIOS DE VALOR - literales de MV-01 §13.1, salvo los dos ultimos.
' =====================================================================

package "Dominios de valor" <<Rectangle>> {

  enum Character {
    alan
    aura
  }

  enum MoodSelfReport {
    muy_mal
    mal
    neutral
    bien
    muy_bien
    prefiero_no_responder
  }

  enum EnergySelfReport {
    baja
    media
    alta
    prefiero_no_responder
  }

  enum ConversationGoal {
    sentirme_escuchado
    calmarme
    ordenar_ideas
    dar_un_paso_pequeno
    recibir_una_sugerencia_breve
    prefiero_no_responder
  }

  enum ResponseStyle {
    breve_y_directo
    equilibrado
    pausado_y_reflexivo
    sin_preferencia
  }

  enum EstadoConsentimiento {
    otorgado
    revocado
  }

  enum EstadoConversacion {
    activa
    cerrada
  }

  enum EstadoDisponibilidad {
    habilitado
    deshabilitado
  }

  enum CapaConsentimiento {
    base
    personalizacion
  }

  enum Rol {
    usuario
    administrador
  }

  enum EstadoDirectorio {
    activo
    sin_consentimiento_vigente
  }
}

' =====================================================================
' RELACIONES DEL ESPACIO DEL PROBLEMA
' Las 17 de MD-01 v1.4, intactas. Multiplicidades SOLO donde MV-01 §13.3 o
' PER-01 §3.3 las declaran; ausentes donde nadie las ha declarado todavia
' (Fowler: una multiplicidad ausente NO significa 1).
' =====================================================================

TitularDeCuenta <|-- Usuario
TitularDeCuenta <|-- Administrador
Personaje <|-- Alan
Personaje <|-- Aura

Visitante -- TitularDeCuenta : precede a
Usuario "1" -- "1..2" Consentimiento : otorga
Usuario "1" -- "1" CapsulaDePerfil : posee
Usuario "1" -- "0..*" Conversacion : mantiene
Usuario -- ContadorDeUsoDiario : tiene
CapsulaDePerfil -- Conversacion : orienta
Conversacion "0..*" -- "1" Personaje : acompanada por
Conversacion "1" *-- "1..*" Mensaje : contiene
Conversacion -- EventoOperativo : se documenta con
Mensaje "1" -- "0..1" EventoDeSeguridad : se documenta con
EventoDeSeguridad "1" -- "1..*" RecursoDeAyuda : remite a
Administrador "1" -- "1" DisponibilidadDelChatbot : tiene a cargo
DisponibilidadDelChatbot "1" -- "0..*" Conversacion : condiciona

' --- Tipado de atributos por dominio de valor ---
Usuario ..> EstadoDirectorio
TitularDeCuenta ..> Rol
Consentimiento ..> CapaConsentimiento
Consentimiento ..> EstadoConsentimiento
Conversacion ..> EstadoConversacion
DisponibilidadDelChatbot ..> EstadoDisponibilidad
CapsulaDePerfil ..> Character
CapsulaDePerfil ..> MoodSelfReport
CapsulaDePerfil ..> EnergySelfReport
CapsulaDePerfil ..> ConversationGoal
CapsulaDePerfil ..> ResponseStyle

' =====================================================================
' RELACIONES DEL ESPACIO DE LA SOLUCION
' Solo las que una operacion EXIGE navegar. Fowler: mostrar todas las
' dependencias es «an exercise in futility». Direccion unica: la
' presentacion depende del dominio, nunca al reves.
' =====================================================================

C_GateDeSeguridad ..> Mensaje
C_GateDeSeguridad ..> EventoDeSeguridad
C_FallbackDeSeguridad ..> Mensaje
C_FallbackDeSeguridad ..> EventoDeSeguridad
C_FallbackDeSeguridad ..> Conversacion
C_FallbackDeSeguridad ..> DisponibilidadDelChatbot
Administrador ..> AccionAdministrativa

B_PaginaPresentacion ..> Visitante
B_FormularioRegistro ..> Visitante
B_FormularioRegistro ..> TitularDeCuenta
B_PaginaInicioSesion ..> TitularDeCuenta
B_PaginaInicioSesion ..> Consentimiento
B_PaginaInicioSesion ..> CapsulaDePerfil
B_PantallaEdad ..> Usuario
B_PantallaConsentimiento ..> Consentimiento
B_PantallaCaracterizacion ..> Consentimiento
B_PantallaCaracterizacion ..> CapsulaDePerfil
B_PantallaEleccionPersonaje ..> Personaje
