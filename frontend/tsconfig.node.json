{
  // Config aparte para archivos que corren en el "mundo Node" del propio tooling de Vite
  // (vite.config.ts), separada de tsconfig.json (que es el "mundo navegador" de src/).
  // Igual que tsconfig.json, extiende la base del monorepo y sobrescribe module/moduleResolution.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts"]
}
