{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "description": "React 19 + Vite + TypeScript + Tailwind v4 (ADR-002). Fase 0a: scaffold, configuración y tokens de diseño (DIS-01). Fase 0b: capa de API, estado de sesión, ruteo y biblioteca base de componentes (shadcn/ui sobre Base UI + 15 primitivas propias).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "pretypecheck": "npm run build -w contrato-api --if-present --prefix ..",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run build -w contrato-api --if-present --prefix ..",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:tokens": "node scripts/lint-tokens.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "contrato-api": "*",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "shadcn": "^4.16.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
